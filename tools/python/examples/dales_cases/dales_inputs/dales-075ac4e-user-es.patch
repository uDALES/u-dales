+contains
+  real function ft_flux(z, zi)
+    real, intent(in) :: z, zi
+    if (z <= zi) then
+      ft_flux = 0.
+    else
+      ft_flux = D * ((z - zi)**(4./3.) / 4. + zi * (z - zi)**(1./3.))
+    end if
+  end function ft_flux
