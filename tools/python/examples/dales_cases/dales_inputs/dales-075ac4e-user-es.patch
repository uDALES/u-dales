 subroutine rad_user
-! DYCOMS version of rad_user adds a radiative forcing above the inversion layer
+! uDALES-comparison patch: DYCOMS-II RF01 free-troposphere term in the flux-divergence form at half levels,
+! with the local zi reset per column; algebraically identical to uDALES
+! src/cases/case_dycoms_rf01.f90 (dycoms_rf01_radiation, local_zi, ft_flux), a = 1 K m^(-4/3).
 use modfields, only : qt0
-use modglobal, only : i1,j1,kmax,dzh,zf
+use modglobal, only : i1,j1,kmax,zf,zh,dzf
 use modraddata, only : thlprad
 implicit none
 integer :: i,j,k
-real    :: thres = 8e-3,a=1,D=3.75e-6
-real    :: zi=0.0
+real, parameter :: thres = 8e-3, D = 3.75e-6
+real    :: zi
 
-!$acc parallel loop collapse(2) default(present) private(k,zi)
-!!$omp target teams loop private(k,zi) collapse(2)&
-!!$omp defaultmap(present:aggregate) defaultmap(present:allocatable)
-  do i=2,j1
   do j=2,j1
-  !Determine local BL-height following the specifications.
+  do i=2,i1
+    zi = -1.
+    if (qt0(i,j,kmax) <= thres) then
+      do k=kmax-1,1,-1
+        if (qt0(i,j,k) > thres) then
+          zi = zf(k) + (thres-qt0(i,j,k))*(zf(k+1)-zf(k))/(qt0(i,j,k+1)-qt0(i,j,k))
+          exit
+        endif
+      enddo
+    endif
+    if (zi <= 0.) cycle
     do k=kmax,1,-1
-      if (qt0(i,j,k) > thres) then
-        zi =zf(k) + (thres-qt0(i,j,k)) &
-                    *dzh(k+1)/(qt0(i,j,k+1)-qt0(i,j,k))
-        exit
-      endif
-    enddo
-    ! Apply the radiative flux divergence
-    do k=kmax,1,-1
-      if (zf(k)< zi) exit
-      thlprad(i,j,k) = thlprad(i,j,k) + a*D/3.*((zf(k)-zi)**(1./3.)+zi*(zf(k)-zi)**(-2./3.))
+      if (zh(k+1) <= zi) exit
+      thlprad(i,j,k) = thlprad(i,j,k) - (ft_flux(real(zh(k+1)),zi) - ft_flux(real(zh(k)),zi))/dzf(k)
