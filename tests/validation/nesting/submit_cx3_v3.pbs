#!/bin/bash
#PBS -N udales-nesting-v3
#PBS -l walltime=08:00:00
#PBS -l select=1:ncpus=64:mpiprocs=64:mem=64gb
#PBS -j oe
#
# V3 -- parent without buildings: the adjustment length, and whether a
# building-free standoff shortens it or lengthens it.
# docs/udales-nesting-design.md section 9.4 and section 10.4 row V3;
# tests/validation/nesting/README.md, "V3 -- parent without buildings".
#
# PREPARE, REVIEW, THEN SUBMIT BY HAND:
#
#     qsub tests/validation/nesting/submit_cx3_v3.pbs
#
# (qsub/qstat live in /opt/pbs/bin on CX3.)
#
# ---------------------------------------------------------------------------
# WHAT THIS RUNS, AND WHY IN THIS ORDER
#
#   1. an equilibrium reference   96 x  96 x 64, periodic 6 x 6 cube array,
#      (920)                      driven by the same fixed dpdx the children
#                                 are.  Its statistics are what "in equilibrium
#                                 with its own canopy" means; without it the
#                                 adjustment length could only be
#                                 self-referential.
#   2. a flat parent (921)       320 x 160 x 64, no buildings at all, driven by
#                                a volume-flow-rate controller at the bulk
#                                velocity measured in step 1.
#   3. an aligned "cubes" parent 320 x 160 x 64, V1-style canopy, fixed dpdx --
#      (926)                     the 'parent had cubes there' arm (below).
#   4. five children (922-927)   256 x 128 x 64: a cube canopy starting 0, 5,
#                                15 or 40 cells past the clear box, driven by
#                                the flat parent (922-925); plus one more at
#                                standoff 0 driven by the aligned "cubes"
#                                parent instead (927, "cleared-parent-cubes"):
#                                same child geometry as 922, but the parent
#                                resolved buildings where the child's zone now
#                                sits and the child clears them
#                                (nest_lparentgeom = .false.).  Comparing 922
#                                against 927 isolates what a genuinely absent
#                                boundary condition costs the adjustment length
#                                from what "parent had cubes, child removed
#                                them" costs -- the V2 finding (nesting-plan-
#                                2026-09-06.md section 0, "New from V2") that
#                                clearing a *child's own* zone costs mean flow,
#                                seen from V3's side of the boundary.
#
# ALL THREE PARENTS WRITE THEIR CHILD'S BOUNDARY BAND AT C_dump <= 2, NOT THE
# WHOLE DOMAIN.  With the mean wind at the domain top ~5.5 m/s (V1's converged
# run, z/h = 2) and dx = 2 m, C_dump <= 2 needs dtdump <= 0.73 s; every parent
# here dumps &NESTDUMP (the child's zone band + 1 cell, src/modnestdump.f90) at
# 0.5 s (C_dump = 1.4 at 5.5 m/s, 0.75 at the preset's own u0 = 3 m/s), and the
# children now interpolate it with the unlimited Catmull-Rom cubic
# (nest_timeinterp = 2, C0c's recommended default) rather than V1's linear.
# Each parent ALSO writes its own whole-domain &OUTPUT field dump
# (parent_output = "both"), but only at the old 3 s cadence: periodic-stats
# reads that back for the bulk velocity and canopy statistics run_geometry.py
# needs, and 3 s was always enough for those.  This is what makes a fine-
# cadence parent affordable: a full 0.5 s field dump of the flat parent alone
# would be ~300 GB (75x the 3 s figure, section 2 of the plan); the band-only
# dump is ~52 GB.  See presets_geometry._NESTDUMP_CADENCE.
#
# Step 2 cannot be built before step 1 has been reduced -- its uflowrate *is*
# that measurement -- so run_geometry.py does them in order and records which
# value it used.  Step 3 needs nothing from step 1: it carries its own drag
# and is driven by the same fixed dpdx as everything else in this experiment.
#
# WHY THE FLAT PARENT IS FLOW-RATE FORCED RATHER THAN dpdx FORCED.  A flat
# surface at the cases' ground roughness (factypes type 1, z0 = 0.05 m) driven by
# the canopy's own dpdx would run at roughly twice the canopy's equilibrium bulk
# velocity, because the canopy drag it is missing is most of the drag.  That is a
# *bulk momentum* mismatch and it is not the one section 9.4 is about: the child
# would be decelerating everywhere and there would be no near-surface equilibrium
# to adjust to.  Matching the bulk instead leaves the child in global momentum
# balance and confines the mismatch to the *shape* of the near-surface profile --
# a log layer down to the ground where the child has a canopy -- which is exactly
# the imposed profile section 9.4 says will be out of equilibrium.  The price is
# that the flat parent carries a weaker surface stress than the canopy does
# (u* ~ 0.18 m/s against 0.4), so it also delivers less turbulence to the
# boundary.  Both are measured and reported.
#
# STANDOFFS 0, 5, 15 are the design table's own comparison; 40 cells = 80 m = 5 h
# is added because the first three are 0, 0.6 and 1.9 building heights, all short
# compared with any plausible adjustment scale, so a sweep of just those could
# fail to separate the hypotheses for want of lever rather than because the claim
# is right.
# ---------------------------------------------------------------------------
#
# SIZING.  Revised 2026-09-07 for the fine &NESTDUMP cadence and the fifth
# child; the previous version (5 h, 245 GB) ran on full-domain dumps at the old
# 3 s cadence throughout and is superseded.  Base rates are the same as before
# -- the measured stage times of the V1 'converged' job (3991175, same node
# type, same 64 ranks, same case family), recorded in
# .github/skills/udales-exec/references/clusters.md:
#
#   parent spin-up   4.19e6 cells, 10800 s simulated, dt 0.379 -> 5479 s
#                    = 2.18e7 cell-steps/s
#   parent produce   the same + dumps                          -> 5916 s
#                    = 2.02e7 cell-steps/s
#   nested child     1.05e6 cells                              -> 1.7e7 cell-steps/s
#   slab cut         ~400 s of fixed read for 170 GB, then ~170 MB/s of write
#   analysis         ~5.1 s per GB of dumps read
#
# What changes with the fine cadence: the parent's own compute is unchanged --
# &NESTDUMP write cost is measured at ~600 MB/s of aggregate per-rank hyperslab
# throughput on the tiny preset (clusters.md, "D1 parent-side zone dump"),
# adding at most a couple of minutes even at production volume, folded into the
# production-phase line below.  What is NOT unchanged is the nesting.inp each
# child's slab cut *writes*: at 0.5 s cadence it holds 6x the time levels of
# the old 3 s file, so at the same measured ~170 MB/s write rate a slab cut
# takes roughly 6x as long on its write side, partly offset because reading a
# NestDump band (this parent's own children read from it, not from the whole-
# domain &OUTPUT dump) is proportionally smaller than reading the old
# full-domain file.  Applied to this experiment (dt = 0.5 s for the flat
# parent, which never reaches the Courant limit -- measured on the tiny
# parent -- and 0.44 s for the urban runs, also measured):
#
#   stage                                            cells      time
#   reference case + spin-up + production          5.90e5     ~15 min
#   flat parent case + preprocessing               3.28e6      ~2 min
#   flat parent spin-up, 9000 s                    3.28e6     ~49 min
#   flat parent production, 3600 s + dumps         3.28e6     ~22 min
#   cubes parent case + spin-up + production       3.28e6     ~84 min  (new;
#         scaled from the reference's own ~15 min/5.90e5-cell figure -- same
#         aligned-array configuration, 5.6x the cells)
#   5 x slab cut (nestdump read, nesting.inp write)            ~59 min  (was
#         ~14 min for 4; each write is ~10-12 min against ~3.5 min before)
#   5 x child case build (IBM preprocessing)                    ~5 min
#   5 x child run, 3591 s simulated                2.04e6     ~78 min
#   periodic statistics (reference + 2 parents)                 ~8 min
#   5 x per-child analysis + shared parent pass                 ~31 min
#                                                    total   ~5 h 53
#
# 8 h against 5 h 53 is 1.35x headroom -- similar margin to the pre-nestdump
# estimate's 1.5x, widened because the new periodic run's scaled build+spin-up+
# production number is the least-measured figure here.  On CX3 a 64-cpu job is
# routed by ncpus and walltime band only -- <=64 cpus and <=24 h both go to
# v1_medium24 -- so widening the request costs nothing but backfill priority;
# see submit_cx3_v4.pbs for the queue-routing detail in full.  If the actual
# run finishes well inside 8 h, tightening this back down is worth doing before
# the next submission -- there is no measurement here, only a scaled estimate.
#
# MEMORY.  As of the D1 zone-dump work the slab cut is a streaming writer whose
# peak memory is independent of the level count (commit 71011e96; previously it
# held the whole nesting file in RAM, which is what the pre-nestdump version of
# this comment sized mem= from).  So mem=64gb, unchanged from before, is not
# tightened here even though nesting.inp itself has grown 6x -- the number this
# used to be sized from no longer describes what the code does.  The remaining
# peak is the legacy child-versus-parent analysis block, three (nt, ni, nj)
# plane series each for the parent and the child: with 6x more parent levels
# now sampled (analysis_parent_stride keeps the two dump intervals apart, but
# the child-vs-parent block reads at the child's own 3 s dtdump, unchanged) the
# figure is the same order as before, ~2 GB.  64gb keeps a wide margin.
#
# DISK, in $RUNDIR, all new (from run_geometry._disk_estimate, which computes
# this table from the presets directly rather than restating it by hand):
#
#   reference dumps                       1200 x  7.1 MB           =   8.5 GB
#   flat parent dumps (both)   OUTPUT  1200 x 39.4 MB =  47.2 GB
#                               NESTDUMP 7200 x  7.2 MB =  51.5 GB  =  98.7 GB
#   cubes parent dumps (both)  same split, new run                 =  98.7 GB
#   nesting.inp                5 x 7200 x 14.2 MB (0.5 s cadence)  = 509.5 GB
#   child dumps                5 x 1200 x 25.2 MB (3 s, unchanged) = 151.0 GB
#                                                        total     = ~866 GB
#
# Ephemeral has ~11 TB (unquotaed, plan.md section 0), so this is not the
# binding constraint; it is 3.5x the pre-nestdump 245 GB because nesting.inp
# now carries the boundary at 0.5 s (6x the levels) for a fifth child, not
# because &NESTDUMP is expensive -- the two parents' *own* dump volume (98.7 GB
# each, both outputs together) is only ~2x the old single-parent, single-
# cadence figure.  --prune-nesting deletes each child's nesting.inp once it has
# run, if that ever gets tight; the analysis does not need it, only a re-run.
#
# Everything else -- the standoffs, the domains, the schedule, the zone -- lives
# in tests/validation/nesting/presets_geometry.py as the 'v3' Experiment.  Change
# it there, not here, so that what runs at production scale is what the tiny
# experiment exercised.

set -e

REPO=${UDALES_REPO:-$HOME/udales/u-dales}
RUNDIR=${UDALES_V3_RUNDIR:-$EPHEMERAL/nesting-v3}
EXPERIMENT=${UDALES_V3_EXPERIMENT:-v3}

echo "repo       : $REPO"
echo "rundir     : $RUNDIR"
echo "experiment : $EXPERIMENT"
echo "started    : $(date)"

mkdir -p "$RUNDIR"

# The solver binary. Build it beforehand with
#   ./tools/build_executable.sh icl release
export UDALES_BUILD=${UDALES_BUILD:-$REPO/build/release/u-dales}
if [ ! -x "$UDALES_BUILD" ]; then
    echo "solver binary not found at $UDALES_BUILD" >&2
    exit 1
fi

# Two module stacks are needed and they are not compatible with each other: the
# Python tooling wants Python/3.9.6-GCCcore-11.2.0, the solver wants the Intel
# 2021a stack.  caselib.run_solver loads the runtime stack itself, in the same
# shell as the mpiexec, so this script only sets up the Python side.
export UDALES_RUNTIME_MODULES="tools/prod intel/2021a netCDF/4.8.0-iimpi-2021a netCDF-Fortran/4.5.3-iimpi-2021a FFTW/3.3.9-intel-2021a"

module purge
module load tools/prod
module load Python/3.9.6-GCCcore-11.2.0
source "${UDALES_VENV:-$HOME/udales/.venv}/bin/activate"

export HDF5_USE_FILE_LOCKING=FALSE
export TMPDIR=${TMPDIR:-$EPHEMERAL}
export MPLCONFIGDIR=${MPLCONFIGDIR:-$RUNDIR/.mpl}

cd "$REPO"
python tests/validation/nesting/run_geometry.py "$RUNDIR" \
    --experiment "$EXPERIMENT" \
    --yes

echo "finished : $(date)"
echo "table    : $RUNDIR/analysis/v3_summary.md"
echo "machine  : $RUNDIR/analysis/v3_summary.json"
echo "per child: $RUNDIR/analysis/<standoff>/v3_metrics.json"
