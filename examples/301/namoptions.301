! DALES BOMEX (Siebesma et al. 2003) on uDALES; see README.md for the source of every value.
&RUN
iexpnr       = 301
runtime      = 21600.       ! 6 h (task spec; DALES case file has 28800 s)
trestart     = 21600.
ladaptive    = .true.       ! adaptive step, matched to the DALES BOMEX run (README, "Time step")
dtmax        = 20.          ! DALES default; never reached in this case
courant      = 0.55         ! uDALES L1 Courant number, no Galilean shift: gives the DALES mean dt (README)
diffnr       = 0.2          ! = DALES peclet 0.15 x 1.32 (uDALES sums 3 terms); not the limiting criterion here
! Fixed time step (use for the DALES comparison, Task 14: DALES must run the same dt):
! ladaptive  = .false.      ! then dt = dtmax; courant and diffnr are ignored; runtime must be a multiple of dtmax
! dtmax      = 3.0          ! s; about the DALES mean dt (3.7 s over 6 h, 3.2 s in hours 3-6), Courant about 0.3 at u = 9 m/s
libm         = .false.
lles         = .true.
nprocx       = 4
nprocy       = 2
lrandomize   = .true.       ! DALES BOMEX noise: thl and qt only (DALES momentum noise is off)
irandom      = 43           ! DALES namoptions
randu        = 0.           ! DALES applies no u, v, w noise
randthl      = 0.1          ! K, DALES namoptions randthl
randqt       = 2.5e-5       ! kg/kg, DALES namoptions randqt
krand        = 80           ! = ktot: all levels, as DALES (krand default = kmax)
/

&OUTPUT
lfielddump   = .false.
ltdump       = .false.
lxytdump     = .false.
/

&DOMAIN
itot         = 64           ! DALES itot, jtot, kmax
jtot         = 64
ktot         = 80
xlen         = 6400.        ! DALES xsize, ysize
ylen         = 6400.
xlat         = 15.          ! DALES
/

&PHYSICS
ps           = 101500.      ! DALES
igrw_damp    = 2            ! DALES default; sponge over the top quarter (ksp default as DALES)
lmoist       = .true.
lcoriol      = .true.
lbuoyancy    = .true.
ltempeq      = .true.
/

&DYNAMICS
lqlnr        = .true.       ! Newton-Raphson ql as DALES (DALES always uses it; its lqlnr is ignored)
iadv_mom     = 2            ! DALES iadv_* = 2 (central differences)
iadv_tke     = 2
iadv_thl     = 2
iadv_qt      = 2
/

&NAMSUBGRID
loneeqn      = .true.
lvreman      = .false.
ldelta       = .false.      ! DALES
/

&WALLS
nfcts        = 0
lbottom      = .true.
/

&BC
BCbotm       = 5            ! MO surface, u* = ustin (DALES isurf = 3)
BCbotT       = 1
BCbotq       = 1
thls         = 299.1        ! DALES
qts          = 1.7e-2       ! first guess only; surface qt is diagnosed every step (prof.inp qt(z1) = 1.697e-2)
wtsurf       = -8.0e-3      ! DALES +8e-3 K m/s upward; uDALES positive = downward (D1)
wqsurf       = -5.2e-5      ! DALES +5.2e-5 kg/kg m/s upward
z0           = 2.0e-4       ! DALES
z0h          = 2.0e-4       ! DALES z0 sets both
ustin        = 0.28         ! DALES
/

&NAMRADIATION
iradiation   = 0            ! the -2 K/day cooling is the thlpcar column of lscale.inp
timerad      = 0.
/

&NAMTHERMOSTAT
lthermostat  = .true.
tthermostat  = 60.
/

&NAMCHECKSIM
tcheck       = 60.          ! mean dt and Courant number to the log every 60 s
/
