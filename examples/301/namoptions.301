! DALES BOMEX (Siebesma et al. 2003) on uDALES; see README.md for the source of every value.
&RUN
iexpnr       = 301
runtime      = 21600.       ! 6 h (task spec; DALES case file has 28800 s)
trestart     = 21600.
ladaptive    = .true.       ! adaptive step, matched to the DALES BOMEX run (README, "Time step")
dtmax        = 20.          ! DALES default; never reached in this case
courant      = 0.55         ! uDALES L1 Courant number; tuned before the e12 halo fix #405, now gives 2.3-4.0 s vs DALES 3.7-6.1 s (RESULTS.md)
diffnr       = 0.2          ! = DALES peclet 0.15 x 1.32 (uDALES sums 3 terms); not the limiting criterion here
! Fixed time step (the DALES close-match comparison, RESULTS.md; DALES runs the same dt):
! ladaptive  = .false.      ! then dt = dtmax; courant and diffnr are ignored; runtime must be a multiple of dtmax
! dtmax      = 2.0          ! s; below the DALES adaptive dt (hourly means 3.7-6.1 s) and the uDALES one (2.3-4.0 s); stable (RESULTS.md)
libm         = .true.       ! the floor is a facet (README)
lles         = .true.
nprocx       = 4
nprocy       = 2
lrandomize   = .true.       ! DALES BOMEX noise: thl and qt only (DALES momentum noise is off)
irandom      = 43           ! DALES namoptions
randu        = 0.           ! DALES applies no u, v, w noise
randthl      = 0.1          ! K, DALES namoptions randthl
randqt       = 2.5e-5       ! kg/kg, DALES namoptions randqt
krand        = 80           ! = ktot: all levels, as DALES (krand default = kmax)
/

&OUTPUT
lfielddump   = .false.
ltdump       = .false.
lxytdump     = .false.
lbldump      = .true.       ! bldump_t and bldump_z: cloud, boundary-layer and radiation diagnostics
tstatsdump   = 60.
/

&DOMAIN
itot         = 64           ! DALES itot, jtot, kmax
jtot         = 64
ktot         = 80
xlen         = 6400.        ! DALES xsize, ysize
ylen         = 6400.
xlat         = 15.          ! DALES
/

&PHYSICS
ps           = 101500.      ! DALES
igrw_damp    = 2            ! DALES default; sponge over the top quarter (ksp default as DALES)
lmoist       = .true.
lcoriol      = .true.
lbuoyancy    = .true.
ltempeq      = .true.
/

&DYNAMICS
lqlnr        = .true.       ! exact ql (Newton-Raphson); DALES dev: two linearised steps, within 0.2 %
iadv_mom     = 2            ! DALES iadv_* = 2 (central differences)
iadv_tke     = 2
iadv_thl     = 2
iadv_qt      = 2
/

&NAMSUBGRID
loneeqn      = .true.
lvreman      = .false.
ldelta       = .false.      ! DALES
/

&WALLS
nfcts        = 1            ! the floor: one horizontal facet (files from tools/python/udprep/flat_floor.py; README)
nsolpts_u    = 0
nsolpts_v    = 0
nsolpts_w    = 4096
nsolpts_c    = 0
nbndpts_u    = 4096
nbndpts_v    = 4096
nbndpts_w    = 4096
nbndpts_c    = 4096
nfctsecs_u   = 4096
nfctsecs_v   = 4096
nfctsecs_w   = 0
nfctsecs_c   = 4096
lbottom      = .false.
iwallmom     = 4            ! Monin-Obukhov on the floor facet (DALES isurf 4, lmostlocal)
iwalltemp    = 1            ! prescribed facet heat flux bctfz
iwallmoist   = 1            ! prescribed facet moisture flux bcqfz (floor facet type has lGR = 1)
ustin        = 0.28         ! DALES ustin: prescribed u* (DALES isurf = 3)
/

&BC
thls         = 299.1        ! DALES; reference surface thl (thvs: base state); the floor facet diagnoses its own
qts          = 1.7e-2       ! reference surface qt (thvs); prof.inp qt(z1) = 1.697e-2
bctfz        = -8.0e-3      ! floor heat flux: DALES wtsurf +8e-3 K m/s upward; uDALES positive = downward (D1)
bcqfz        = -5.2e-5      ! floor moisture flux: DALES wqsurf +5.2e-5 kg/kg m/s upward
/

&NAMRADIATION
iradiation   = 0            ! the -2 K/day cooling is the thlpcar column of lscale.inp
timerad      = 0.
/

&NAMCHECKSIM
tcheck       = 60.          ! mean dt and Courant number to the log every 60 s
/
