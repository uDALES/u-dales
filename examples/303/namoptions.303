! DYCOMS-II RF01 (Stevens et al. 2005) on uDALES; see README.md for sources.
&RUN
iexpnr       = 303
runtime      = 14400.       ! 4 h
trestart     = 14400.
ladaptive    = .true.       ! PROVISIONAL until Task 14 (README, "Time step")
dtmax        = 20.          ! DALES default; never reached
courant      = 0.5          ! as the DALES RF01 reference run; not limiting (diffusion limits the step)
diffnr       = 0.16         ! = DALES peclet 0.15 x 1.065 (uDALES sums 3 terms); sets the step, about 0.5 s
! Fixed time step (the DALES close-match comparison, RESULTS.md; DALES runs the same dt):
! ladaptive  = .false.      ! then dt = dtmax; courant and diffnr are ignored; runtime must be a multiple of dtmax
! dtmax      = 0.3          ! s; below both codes' adaptive dt (DALES hourly means 0.39-0.43 s); 60 s output = 200 steps
libm         = .false.
lles         = .true.
nprocx       = 8
nprocy       = 4
lrandomize   = .true.       ! DALES RF01 noise: thl and qt (DALES momentum noise is off)
irandom      = 43           ! DALES
randu        = 0.           ! DALES applies no u, v, w noise
randthl      = 0.1          ! K, DALES dycoms_rf02 randthl
randqt       = 2.5e-5       ! kg/kg, DALES dycoms_rf02 randqt
krand        = 300          ! = ktot: all levels, as DALES
/

&OUTPUT
lfielddump   = .false.
ltdump       = .false.
lxytdump     = .false.
/

&DOMAIN
itot         = 96           ! Stevens et al. 2005 / task spec: 96 x 96 x 300, dx = 35 m, dz = 5 m
jtot         = 96
ktot         = 300
xlen         = 3360.
ylen         = 3360.
xlat         = 31.5         ! f = 0.76e-4 1/s (PyCLES ForcingDyCOMS_RF01)
/

&PHYSICS
ps           = 101780.      ! PyCLES RS.Pg = 1017.8 hPa
igrw_damp    = 2            ! sponge over the top quarter (ksp default)
lmoist       = .true.
lcoriol      = .true.
lbuoyancy    = .true.
ltempeq      = .true.
/

&DYNAMICS
lqlnr        = .true.       ! Newton-Raphson ql as DALES (its lqlnr is ignored, always NR)
iadv_mom     = 2
iadv_tke     = 2
iadv_thl     = 2
iadv_qt      = 2
/

&NAMSUBGRID
loneeqn      = .true.
lvreman      = .false.
ldelta       = .false.
/

&WALLS
nfcts        = 0
lbottom      = .true.
/

&BC
BCbotm       = 4            ! MO surface with a z0 that gives neutral Cm = 0.0011 at z1 = 2.5 m
BCbotT       = 1
BCbotq       = 1
thls         = 289.         ! first guess (surface thl is diagnosed every step)
qts          = 9.0e-3       ! first guess
wtsurf       = -1.22460976e-02   ! SHF 15 W/m2 upward / (1.22 kg/m3 * 1004 J/kg/K); negative = upward (D1)
wqsurf       = -3.72578241e-05   ! LHF 115 W/m2 upward / (1.22 kg/m3 * 2.53e6 J/kg)
z0           = 1.069564e-05      ! 2.5 m * exp(-0.41 / sqrt(0.0011)); printed by make_rf01.py
z0h          = 1.069564e-05
/

&NAMRADIATION
iradiation   = 2
rad_longw    = .true.
rka          = 85.          ! m2/kg (PyCLES kap)
dlwtop       = 70.          ! F0
dlwbot       = 22.          ! F1
timerad      = 0.
/

&NAMCASES
case_hooks   = 'dycoms_rf01'   ! free-troposphere radiation term (src/cases/case_dycoms_rf01.f90)
/

&NAMCASE_DYCOMS
dycoms_D        = 3.75e-6   ! large-scale divergence [1/s]
dycoms_qt_thres = 8.0e-3    ! qt defining the local inversion height [kg/kg]
/

&NAMTHERMOSTAT
lthermostat  = .true.
tthermostat  = 60.
zi_qt_thres  = 8.e-3        ! zi_qt: BL height from the qt = 8 g/kg crossing
/

&NAMCHECKSIM
tcheck       = 60.          ! mean dt and Courant number to the log every 60 s
/
