cmake_minimum_required(VERSION 3.9)

project(downloadBuild2decomp NONE)

include(ExternalProject)

# Pinned to the upstream dev branch at the merge of PR 426 (2025-12-11), the
# fix for issue 401 (halo messages with the same tag when a periodic direction
# has one rank; uDALES runs such decompositions). The commit before it,
# cf8a75d, is the squash merge of PR 414, which brought in the halo_exchange
# interfaces uDALES uses (previously taken from the fork branch
# pbartholomew08/2decomp-fft feat--halo-exchange--udales, tree-identical to
# cf8a75d). A commit hash, not a branch, so that builds are reproducible.
ExternalProject_Add(downloadBuild2decomp
    GIT_REPOSITORY    "https://github.com/2decomp-fft/2decomp-fft"
    GIT_TAG           "c16656a8206f5b7c87536e42d2a3d23b3c9b2a66"
    CMAKE_ARGS        ${UDALES_DECOMP2D_ARGS}
    SOURCE_DIR        "${CMAKE_CURRENT_BINARY_DIR}/decomp2d-src"
    INSTALL_DIR       "${CMAKE_CURRENT_BINARY_DIR}/decomp2d-opt"
    TEST_COMMAND      ""
)

